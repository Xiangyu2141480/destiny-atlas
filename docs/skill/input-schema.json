{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DestinyAtlasInput",
  "type": "object",
  "required": ["date", "time", "placeId", "mbti"],
  "properties": {
    "name": { "type": "string", "maxLength": 50 },
    "date": { "type": "string", "format": "date" },
    "time": { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" },
    "placeId": { "type": "string", "description": "ID from src/data/places.ts" },
    "mbti": { "enum": ["INTJ","INTP","ENTJ","ENTP","INFJ","INFP","ENFJ","ENFP","ISTJ","ISFJ","ESTJ","ESFJ","ISTP","ISFP","ESTP","ESFP"] },
    "trueSolarTime": { "type": "boolean", "default": false },
    "focus": { "enum": ["career", "finance", "relationships", "growth", "balance"] },
    "startMonth": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" }
  },
  "additionalProperties": false
}
