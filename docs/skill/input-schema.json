{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DestinyAtlasInput",
  "type": "object",
  "required": [
    "date",
    "time",
    "placeId",
    "mbti"
  ],
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 50
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string",
      "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
    },
    "placeId": {
      "type": "string",
      "description": "ID from src/data/places.ts"
    },
    "mbti": {
      "enum": [
        "INTJ",
        "INTP",
        "ENTJ",
        "ENTP",
        "INFJ",
        "INFP",
        "ENFJ",
        "ENFP",
        "ISTJ",
        "ISFJ",
        "ESTJ",
        "ESFJ",
        "ISTP",
        "ISFP",
        "ESTP",
        "ESFP"
      ]
    },
    "trueSolarTime": {
      "type": "boolean",
      "default": false
    },
    "focus": {
      "enum": [
        "career",
        "finance",
        "relationships",
        "growth",
        "balance"
      ]
    },
    "startMonth": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])$"
    },
    "customPlace": {
      "type": "object",
      "required": [
        "id",
        "name",
        "country",
        "latitude",
        "longitude",
        "timezone"
      ],
      "properties": {
        "id": {
          "const": "custom"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "country": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "timezone": {
          "type": "string",
          "description": "Valid IANA timezone; validated by the runtime"
        },
        "source": {
          "type": "object",
          "required": [
            "provider",
            "id",
            "license",
            "modified"
          ],
          "properties": {
            "provider": {
              "const": "open-meteo"
            },
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "license": {
              "const": "CC BY-NC 4.0"
            },
            "modified": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "placeId": {
            "const": "custom"
          }
        }
      },
      "then": {
        "required": [
          "customPlace"
        ]
      }
    }
  ]
}
